# =================================================================
# Clean page addresses (Apache hosting, e.g. Hostinger, cPanel)
# -----------------------------------------------------------------
#   mnathanvz.space/portfolio       → shows portfolio.html
#   mnathanvz.space/portfolio.html  → redirects to /portfolio
#   mnathanvz.space/index.html      → redirects to /
# =================================================================

Options -MultiViews
RewriteEngine On

# Old addresses ending in .html redirect to the clean version
RewriteCond %{THE_REQUEST} \s/+(.*?/)?index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# A clean address loads the matching .html file
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
